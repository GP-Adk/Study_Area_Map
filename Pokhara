local_units.plot(
    ax=ax_nepal,
    facecolor="#f7f7f7",
    edgecolor="0.65",
    linewidth=0.20,
    zorder=1,
)

# Draw district boundaries
districts.boundary.plot(
    ax=ax_nepal,
    color="0.35",
