# ============================================================
# 12. HELPER FUNCTIONS
# ============================================================

def format_map_axis(
    axis,
    extent,
    title,
    panel_label,
):
    """
    Format the coordinate grid, labels, title, and panel label.
    """

    axis.set_xlim(
        extent[0],
        extent[1],
    )

    axis.set_ylim(
        extent[2],
        extent[3],
    )

    axis.set_aspect(
        "equal",
        adjustable="box",
    )

    axis.set_xlabel(
        "Longitude (°E)"
    )

    axis.set_ylabel(
        "Latitude (°N)"
    )

    axis.set_title(
        title,
        fontweight="bold",
        pad=9,
    )

    axis.grid(
        True,
        linestyle=":",
        linewidth=0.45,
        alpha=0.65,
    )

    for spine in axis.spines.values():
        spine.set_color("black")
        spine.set_linewidth(1.0)

    axis.text(
        0.02,
        0.97,
        panel_label,
        transform=axis.transAxes,
        ha="left",
        va="top",
        fontsize=12,
        fontweight="bold",
        bbox={
            "facecolor": "white",
            "edgecolor": "black",
            "linewidth": 0.7,
            "boxstyle": "square,pad=0.20",
        },
        zorder=20,
    )


def plot_pokhara_station(
    axis,
    longitude_offset,
    latitude_offset,
):
    """
    Plot the Pokhara AERONET station and its label.
    """

    axis.scatter(
        POKHARA_SITE["longitude"],
        POKHARA_SITE["latitude"],
        marker="*",
        s=170,
        facecolor="red",
        edgecolor="black",
        linewidth=0.9,
        zorder=15,
    )

    axis.annotate(
        "Pokhara AERONET",
        xy=(
            POKHARA_SITE["longitude"],
            POKHARA_SITE["latitude"],
        ),
        xytext=(
            POKHARA_SITE["longitude"]
            + longitude_offset,
            POKHARA_SITE["latitude"]
            + latitude_offset,
        ),
        fontsize=9,
        fontweight="bold",
        ha="left",
        va="bottom",
        arrowprops={
            "arrowstyle": "-",
            "linewidth": 0.8,
            "color": "black",
        },
        bbox={
            "facecolor": "white",
            "edgecolor": "none",
            "alpha": 0.80,
            "pad": 1.5,
        },
        zorder=16,
    )


def add_north_arrow(
    axis,
    x=0.91,
    y=0.88,
):
    """
    Add a simple north arrow.
    """

    axis.annotate(
        "N",
        xy=(x, y),
        xytext=(x, y - 0.13),
        xycoords=axis.transAxes,
        textcoords=axis.transAxes,
        ha="center",
        va="center",
        fontsize=10,
        fontweight="bold",
        arrowprops={
            "arrowstyle": "-|>",
            "linewidth": 1.1,
            "color": "black",
        },
        zorder=20,
    )


# ============================================================
# 13. CREATE TWO-PANEL FIGURE
# ============================================================

fig, axes = plt.subplots(
    nrows=1,
    ncols=2,
    figsize=(12, 6.2),
    gridspec_kw={
        "width_ratios": [
            1.35,
            1.00,
