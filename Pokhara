from pathlib import Path
import os

import geopandas as gpd
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D
from matplotlib.patches import Patch
from shapely.geometry import Point


# ============================================================
# 1. INPUT AND OUTPUT PATHS
# ============================================================

# Keep all shapefile components in the same folder:
# local_unit.shp
# local_unit.shx
# local_unit.dbf
# local_unit.prj
#
# When the shapefile and notebook are in the same folder:
LOCAL_UNIT_SHP = Path("local_unit.shp")

# Windows example:
# LOCAL_UNIT_SHP = Path(
#     r"C:\Users\gpadh\Downloads\Nepal_administrative_map"
#     r"\local_unit.shp"
# )

# Create the output folder automatically
OUTPUT_DIR = Path("pokhara_study_area")
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

PNG_OUTPUT = OUTPUT_DIR / "Pokhara_study_area_map.png"
PDF_OUTPUT = OUTPUT_DIR / "Pokhara_study_area_map.pdf"
SVG_OUTPUT = OUTPUT_DIR / "Pokhara_study_area_map.svg"


# ============================================================
# 2. POKHARA AERONET STATION INFORMATION
# ============================================================

POKHARA_SITE = {
    "name": "Pokhara AERONET",
    "longitude": 83.975180,
    "latitude": 28.186643,
    "elevation_m": 800,
}


# ============================================================
# 3. READ THE UPDATED ADMINISTRATIVE SHAPEFILE
# ============================================================

if not LOCAL_UNIT_SHP.exists():
    raise FileNotFoundError(
        "The shapefile was not found:\n"
        f"{LOCAL_UNIT_SHP.resolve()}\n\n"
        "Place local_unit.shp, local_unit.shx, local_unit.dbf, "
        "and local_unit.prj in the same folder."
    )

# This allows recovery when the SHX file has a minor issue
os.environ["SHAPE_RESTORE_SHX"] = "YES"

local_units = gpd.read_file(
    LOCAL_UNIT_SHP,
    engine="fiona",
)

print("Original CRS:")
print(local_units.crs)

print("\nAvailable columns:")
print(local_units.columns.tolist())

# Convert the administrative data to WGS84
if local_units.crs is None:
    raise ValueError(
        "The shapefile has no coordinate reference system. "
        "Make sure local_unit.prj is present."
    )

local_units = local_units.to_crs("EPSG:4326")


# ============================================================
# 4. STANDARDIZE TEXT COLUMNS
# ============================================================

required_columns = [
    "DISTRICT",
    "GaPa_NaPa",
]

missing_columns = [
    column
    for column in required_columns
    if column not in local_units.columns
]

if missing_columns:
    raise KeyError(
        "The following required columns were not found:\n"
        f"{missing_columns}\n\n"
        f"Available columns are:\n{local_units.columns.tolist()}"
    )

local_units["DISTRICT"] = (
    local_units["DISTRICT"]
    .astype(str)
    .str.strip()
    .str.upper()
)

local_units["GaPa_NaPa"] = (
    local_units["GaPa_NaPa"]
    .astype(str)
    .str.strip()
)


# ============================================================
# 5. CREATE DISTRICT AND COUNTRY BOUNDARIES
# ============================================================

# Dissolve local units to obtain district polygons
districts = local_units.dissolve(
    by="DISTRICT",
    as_index=False,
)

# Dissolve all polygons to obtain Nepal's outer boundary
nepal_boundary = local_units.dissolve()


# ============================================================
# 6. CREATE THE POKHARA STATION POINT
# ============================================================

pokhara_station = gpd.GeoDataFrame(
    {
        "site": [POKHARA_SITE["name"]],
        "elevation_m": [POKHARA_SITE["elevation_m"]],
    },
    geometry=[
        Point(
            POKHARA_SITE["longitude"],
            POKHARA_SITE["latitude"],
        )
    ],
    crs="EPSG:4326",
)


# ============================================================
# 7. IDENTIFY THE DISTRICT CONTAINING THE STATION
# ============================================================

station_district_join = gpd.sjoin(
    pokhara_station,
    districts[["DISTRICT", "geometry"]],
    how="left",
    predicate="intersects",
)

if station_district_join["DISTRICT"].isna().all():
    raise ValueError(
        "The Pokhara station could not be matched with a district. "
        "Check the station coordinates and the shapefile CRS."
    )

pokhara_district_name = (
    station_district_join["DISTRICT"]
    .dropna()
    .iloc[0]
)

print("\nDistrict containing the Pokhara station:")
print(pokhara_district_name)


# ============================================================
# 8. IDENTIFY THE LOCAL UNIT CONTAINING THE STATION
# ============================================================

station_local_join = gpd.sjoin(
    pokhara_station,
    local_units[
        [
            "DISTRICT",
            "GaPa_NaPa",
            "geometry",
        ]
    ],
    how="left",
    predicate="intersects",
)

if station_local_join["GaPa_NaPa"].isna().all():
    pokhara_local_unit_name = None
    print("\nThe local unit containing the station was not identified.")
else:
    pokhara_local_unit_name = (
        station_local_join["GaPa_NaPa"]
        .dropna()
        .iloc[0]
    )

    print("\nLocal unit containing the Pokhara station:")
    print(pokhara_local_unit_name)


# ============================================================
# 9. EXTRACT POKHARA/KASKI DISTRICT DATA
# ============================================================

pokhara_district = districts[
    districts["DISTRICT"] == pokhara_district_name
].copy()

pokhara_district_local_units = local_units[
    local_units["DISTRICT"] == pokhara_district_name
].copy()

if pokhara_local_unit_name is not None:
    station_local_unit = local_units[
        (
            local_units["DISTRICT"]
            == pokhara_district_name
        )
        &
        (
            local_units["GaPa_NaPa"]
            == pokhara_local_unit_name
        )
    ].copy()
else:
    station_local_unit = None


# ============================================================
# 10. CALCULATE MAP EXTENTS
# ============================================================

def calculate_extent(
    geodataframe,
    x_padding_fraction=0.08,
    y_padding_fraction=0.08,
):
    """
    Calculate a padded map extent from a GeoDataFrame.
    """

    min_x, min_y, max_x, max_y = geodataframe.total_bounds

    width = max_x - min_x
    height = max_y - min_y

    x_padding = width * x_padding_fraction
    y_padding = height * y_padding_fraction

    return [
        min_x - x_padding,
        max_x + x_padding,
        min_y - y_padding,
        max_y + y_padding,
    ]


nepal_extent = calculate_extent(
    nepal_boundary,
    x_padding_fraction=0.04,
    y_padding_fraction=0.07,
)

pokhara_extent = calculate_extent(
    pokhara_district,
    x_padding_fraction=0.12,
    y_padding_fraction=0.12,
)


