    OUTPUT_DIR
    / "Kathmandu_Valley_study_area_map.svg"
)


# ============================================================
# 2. ICIMOD AERONET SITE INFORMATION
# ============================================================

ICIMOD_SITE = {
    "name": "ICIMOD AERONET",
    "longitude": 85.323269,
    "latitude": 27.646647,
    "elevation_m": 1326,
}


# ============================================================
# 3. DISTRICTS DEFINING KATHMANDU VALLEY
# ============================================================

KATHMANDU_VALLEY_DISTRICTS = [
    "KATHMANDU",
    "LALITPUR",
    "BHAKTAPUR",
]


# ============================================================
# 4. READ THE UPDATED ADMINISTRATIVE SHAPEFILE
# ============================================================

if not LOCAL_UNIT_SHP.exists():
    raise FileNotFoundError(
        "The shapefile was not found:\n"
        f"{LOCAL_UNIT_SHP.resolve()}\n\n"
        "Place local_unit.shp, local_unit.shx, "
        "local_unit.dbf, and local_unit.prj "
        "in the same folder."
    )

os.environ["SHAPE_RESTORE_SHX"] = "YES"

local_units = gpd.read_file(
    LOCAL_UNIT_SHP,
    engine="fiona",
)

print("Original CRS:")
print(local_units.crs)

print("\nAvailable columns:")
print(local_units.columns.tolist())


# ============================================================
# 5. CHECK AND CONVERT THE CRS
# ============================================================

if local_units.crs is None:
    raise ValueError(
        "The shapefile has no coordinate reference system. "
        "Make sure local_unit.prj is present."
    )

# Convert to WGS84 longitude and latitude
local_units = local_units.to_crs(
    "EPSG:4326"
)


# ============================================================
# 6. STANDARDIZE ATTRIBUTE COLUMNS
# ============================================================

required_columns = [
    "DISTRICT",
    "GaPa_NaPa",
]

missing_columns = [
    column
    for column in required_columns
    if column not in local_units.columns
]

if missing_columns:
    raise KeyError(
        "Required columns were not found:\n"
        f"{missing_columns}\n\n"
        f"Available columns:\n"
        f"{local_units.columns.tolist()}"
    )

local_units["DISTRICT"] = (
    local_units["DISTRICT"]
    .astype(str)
    .str.strip()
    .str.upper()
)

local_units["GaPa_NaPa"] = (
    local_units["GaPa_NaPa"]
    .astype(str)
    .str.strip()
)


# ============================================================
# 7. CREATE DISTRICT AND NEPAL BOUNDARIES
# ============================================================

# District polygons created from local units
districts = local_units.dissolve(
    by="DISTRICT",
    as_index=False,
)

# Complete outer boundary of Nepal
nepal_boundary = local_units.dissolve()


# ============================================================
# 8. SELECT KATHMANDU VALLEY
# ============================================================

valley_local_units = local_units[
    local_units["DISTRICT"].isin(
        KATHMANDU_VALLEY_DISTRICTS
    )
].copy()

valley_districts = districts[
    districts["DISTRICT"].isin(
        KATHMANDU_VALLEY_DISTRICTS
    )
].copy()

# Combined Kathmandu Valley outline
valley_boundary = valley_districts.dissolve()

if valley_local_units.empty:
    raise ValueError(
        "Kathmandu Valley districts were not found "
        "in the administrative shapefile."
    )


# ============================================================
# 9. CREATE THE ICIMOD STATION POINT
# ============================================================

icimod_station = gpd.GeoDataFrame(
    {
        "site": [ICIMOD_SITE["name"]],
        "elevation_m": [
            ICIMOD_SITE["elevation_m"]
        ],
    },
    geometry=[
        Point(
            ICIMOD_SITE["longitude"],
            ICIMOD_SITE["latitude"],
        )
    ],
    crs="EPSG:4326",
)


# ============================================================
# 10. IDENTIFY THE DISTRICT CONTAINING THE STATION
# ============================================================

station_district_join = gpd.sjoin(
    icimod_station,
    valley_districts[
        [
            "DISTRICT",
            "geometry",
        ]
    ],
    how="left",
    predicate="intersects",
)

if station_district_join["DISTRICT"].isna().all():
    station_district_name = None
    print(
        "\nThe station could not be matched "
        "with a Kathmandu Valley district."
    )
else:
    station_district_name = (
        station_district_join["DISTRICT"]
        .dropna()
        .iloc[0]
    )

    print("\nDistrict containing the station:")
    print(station_district_name)


# ============================================================
# 11. IDENTIFY THE LOCAL UNIT CONTAINING THE STATION
# ============================================================

station_local_join = gpd.sjoin(
    icimod_station,
    valley_local_units[
        [
            "DISTRICT",
            "GaPa_NaPa",
            "geometry",
        ]
    ],
    how="left",
    predicate="intersects",
)

if station_local_join["GaPa_NaPa"].isna().all():
    station_local_unit_name = None
    station_local_unit = None

    print(
        "\nThe local unit containing the station "
        "could not be identified."
    )

else:
    station_local_unit_name = (
        station_local_join["GaPa_NaPa"]
        .dropna()
        .iloc[0]
    )

    station_local_unit = valley_local_units[
        valley_local_units["GaPa_NaPa"]
        == station_local_unit_name
    ].copy()

    print("\nLocal unit containing the station:")
    print(station_local_unit_name)


# ============================================================
# 12. CALCULATE MAP EXTENTS
# ============================================================

def calculate_extent(
    geodataframe,
    x_padding_fraction=0.08,
    y_padding_fraction=0.08,
):
    """
    Calculate a padded map extent.
    """

    min_x, min_y, max_x, max_y = (
        geodataframe.total_bounds
    )

    width = max_x - min_x
    height = max_y - min_y

    x_padding = (
        width * x_padding_fraction
    )

    y_padding = (
        height * y_padding_fraction
    )

    return [
        min_x - x_padding,
        max_x + x_padding,
        min_y - y_padding,
        max_y + y_padding,
    ]


nepal_extent = calculate_extent(
    nepal_boundary,
    x_padding_fraction=0.04,
    y_padding_fraction=0.07,
)

valley_extent = calculate_extent(
    valley_boundary,
    x_padding_fraction=0.12,
    y_padding_fraction=0.12,
)


