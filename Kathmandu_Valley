def format_map_axis(
    axis,
    extent,
    title,
    panel_label,
):
    """
    Format the map extent, grid, labels, and title.
    """

    axis.set_xlim(
        extent[0],
        extent[1],
    )

    axis.set_ylim(
        extent[2],
        extent[3],
    )

    axis.set_aspect(
        "equal",
        adjustable="box",
    )

    axis.set_xlabel(
        "Longitude (°E)"
    )

    axis.set_ylabel(
        "Latitude (°N)"
    )

    axis.set_title(
        title,
        fontweight="bold",
        pad=9,
    )

    axis.grid(
        True,
        linestyle=":",
        linewidth=0.45,
        alpha=0.65,
    )

    for spine in axis.spines.values():
        spine.set_color("black")
        spine.set_linewidth(1.0)

    axis.text(
        0.02,
        0.97,
        panel_label,
        transform=axis.transAxes,
        ha="left",
        va="top",
        fontsize=12,
        fontweight="bold",
        bbox={
            "facecolor": "white",
            "edgecolor": "black",
            "linewidth": 0.7,
            "boxstyle": "square,pad=0.20",
        },
        zorder=30,
    )


def plot_icimod_station(
    axis,
    longitude_offset,
    latitude_offset,
):
    """
    Plot and label the ICIMOD AERONET station.
    """

    axis.scatter(
        ICIMOD_SITE["longitude"],
        ICIMOD_SITE["latitude"],
        marker="*",
        s=180,
        facecolor="red",
        edgecolor="black",
        linewidth=0.9,
        zorder=20,
    )

    axis.annotate(
        "ICIMOD AERONET",
        xy=(
            ICIMOD_SITE["longitude"],
            ICIMOD_SITE["latitude"],
        ),
        xytext=(
            ICIMOD_SITE["longitude"]
            + longitude_offset,
            ICIMOD_SITE["latitude"]
            + latitude_offset,
        ),
        fontsize=9,
        fontweight="bold",
        ha="left",
        va="bottom",
        arrowprops={
            "arrowstyle": "-",
            "linewidth": 0.8,
            "color": "black",
        },
        bbox={
            "facecolor": "white",
            "edgecolor": "none",
            "alpha": 0.82,
            "pad": 1.5,
        },
        zorder=21,
    )


def add_north_arrow(
    axis,
    x=0.91,
    y=0.88,
):
    """
    Add a simple north arrow.
    """

    axis.annotate(
        "N",
        xy=(x, y),
        xytext=(x, y - 0.13),
        xycoords=axis.transAxes,
        textcoords=axis.transAxes,
        ha="center",
        va="center",
        fontsize=10,
        fontweight="bold",
        arrowprops={
            "arrowstyle": "-|>",
            "linewidth": 1.1,
            "color": "black",
        },
        zorder=30,
    )


def add_district_labels(
    axis,
    district_layer,
):
    """
    Add labels for Kathmandu, Lalitpur, and Bhaktapur.
    """

    for _, row in district_layer.iterrows():

        label_point = (
            row.geometry
            .representative_point()
        )

        axis.text(
            label_point.x,
            label_point.y,
            row["DISTRICT"].title(),
            fontsize=8,
            fontweight="bold",
            ha="center",
            va="center",
            bbox={
                "facecolor": "white",
                "edgecolor": "none",
                "alpha": 0.65,
                "pad": 1.0,
            },
            zorder=12,
        )


